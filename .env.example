# PostgreSQL
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp_dev_password
POSTGRES_DB=fsp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fsp:fsp_dev_password@localhost:5432/fsp?schema=public

# API
API_PORT=4000
API_PREFIX=api
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Telegram (optional — system works without it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public URLs
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Docker (defaults work without .env)
COMPOSE_PROJECT_NAME=hackathon
WEB_PORT=3000
DOCKER_PUBLIC_URL=http://localhost:3000
DOCKER_SEED_DEMO=true
# false for local HTTP; set true behind HTTPS
SESSION_COOKIE_SECURE=false
